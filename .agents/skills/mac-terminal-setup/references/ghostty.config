# ============================================================
#  Ghostty 配置 —— 完整选项查 `ghostty +show-config --default --docs`
#  注意：Ghostty 配置**不支持行尾注释**，注释必须独占一行
# ============================================================

# ----- 字体 -----
font-family = "JetBrainsMono Nerd Font"
font-size = 14
# 行高调宽一点，长 log 滚动时更舒服
adjust-cell-height = 10%

# ----- 主题 -----
# 内置主题：跑 `ghostty +list-themes` 浏览
# 默认：GitHub Dark High Contrast —— 强光环境下也能看清，前景色全部加亮一档。
# 暗环境/夜晚可换成 Tokyo Night（"tokyonight"），更柔和但前景偏暗。
# 切主题需要 Cmd+Q 重启 Ghostty 才生效（Ghostty 不支持运行时切换）。
theme = "GitHub Dark High Contrast"

# ----- 窗口 -----
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true
window-decoration = true
macos-titlebar-style = "tabs"
# 让 Option 键当 Alt 用，使 Alt-C / Alt-. 在 fzf / atuin 里能工作
macos-option-as-alt = true
# 透明度默认关掉。强光环境下，背景透明会让屏后光线穿透，
# 进一步降低对比度。如果你日常在暗环境，可以把这两行改成
#   background-opacity = 0.97
#   background-blur = true
background-opacity = 1.0
background-blur = false

# ----- 光标 -----
cursor-style = "block"
cursor-style-blink = false

# ----- 滚动缓冲 -----
scrollback-limit = 100000

# ----- Shell 集成 -----
# Ghostty 会自动给 zsh 注入 shell 集成 —— 保持 cwd、OSC 7 等
shell-integration = "zsh"
shell-integration-features = "cursor,sudo,title"

# ----- 键位 -----
# Cmd-T 新标签、Cmd-D 垂直分屏、Cmd-Shift-D 水平分屏
keybind = "cmd+d=new_split:right"
keybind = "cmd+shift+d=new_split:down"
keybind = "cmd+w=close_surface"
keybind = "cmd+shift+enter=toggle_split_zoom"

# ----- 杂项 -----
copy-on-select = "clipboard"
confirm-close-surface = false
